APP_ENV=development
CONNECTORS_DEVELOPMENT_MODE=false
APP_ADDR=:8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_REQUEST_TIMEOUT=30s
LOG_FORMAT=pretty
PG_DSN=postgres://odyssey:odyssey@postgres:5432/odyssey?sslmode=disable
REDIS_ADDR=redis:6379
SESSION_SECRET=change-me
SESSION_TTL=720h
CSRF_SECRET=change-me
APP_MASTER_KEY=change-me-in-a-secret-manager
# --- Optional settings (commented = built-in default from internal/app/config.go) ---
# Worker Postgres pool size; omit rather than leave empty (see docs/DEPLOYMENT.md).
# PG_MAX_CONNS=24
# Board pack PDF storage: local directory, or S3-compatible when DRIVER=s3.
# BOARD_PACK_STORAGE=./var/boardpacks
# BOARD_PACK_STORAGE_DRIVER=local
# BOARD_PACK_S3_ENDPOINT=
# BOARD_PACK_S3_REGION=us-east-1
# BOARD_PACK_S3_BUCKET=odyssey-boardpacks
# BOARD_PACK_S3_ACCESS_KEY_ID=
# BOARD_PACK_S3_SECRET_ACCESS_KEY=
# BOARD_PACK_S3_USE_PATH_STYLE=true
# BOARD_PACK_S3_AUTO_CREATE_BUCKET=false
# Exchange-rate provider for transaction FX.
# FX_PROVIDER=exchangerate-api
# FX_API_BASE_URL=https://open.er-api.com/v6
# FX_API_KEY=
# FX_BASE_CURRENCY=IDR
# FX_FETCH_TIMEOUT=10s
# FX_MAX_RATE_AGE=48h
# One-off cmd/bootstrap-admin only; never keep these in a long-lived env file.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@odyssey.local
SMTP_USERNAME=
SMTP_PASSWORD=
GOTENBERG_URL=http://gotenberg:3000
