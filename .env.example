APP_ENV=development
CONNECTORS_DEVELOPMENT_MODE=false
APP_ADDR=:8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_REQUEST_TIMEOUT=30s
LOG_FORMAT=pretty
PG_DSN=postgres://odyssey:odyssey@postgres:5432/odyssey?sslmode=disable
REDIS_ADDR=redis:6379
SESSION_SECRET=change-me
SESSION_TTL=720h
CSRF_SECRET=change-me
APP_MASTER_KEY=change-me-in-a-secret-manager
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@odyssey.local
SMTP_USERNAME=
SMTP_PASSWORD=
GOTENBERG_URL=http://gotenberg:3000
# users.id the worker's hourly CMMS PM scan records as requester/actor of
# generated work orders. Required wherever the worker runs; 0 disables the scan.
CMMS_SYSTEM_USER_ID=0
# Comma-separated role names whose holders see every company. Empty by default:
# everyone else sees only the companies of their active role assignments.
RBAC_GLOBAL_ROLES=
# Directory shared by app and worker for document blobs (local driver only).
# /data/storage is where docker-compose mounts the "documents" volume; keep it
# when running under compose. Left empty, the app uses data/storage (relative
# to the working directory) in development and /var/lib/odyssey/storage in
# staging/production.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DIR=/data/storage
